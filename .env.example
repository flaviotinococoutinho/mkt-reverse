# =============================================================================
# QUEROJÁ — MARKETPLACE REVERSO C2B — ENVIRONMENT CONFIGURATION (MVP)
# =============================================================================
# Escopo deliberado do MVP (ver README + docs/compliance/guardrails.md):
# - Sem e-mail, sem upload de imagens, sem Kafka/Elasticsearch.
# - Eventing via Transactional Outbox Light (tabela event_outbox + scheduler).
# - Dinheiro NUNCA transita em conta própria: escrow somente via PSP autorizado
#   pelo BACEN (Fase 1). As chaves de PSP abaixo ficam vazias até a Fase 1.

# Application Environment
SPRING_PROFILES_ACTIVE=local
APP_NAME=queroja
APP_VERSION=1.0.0-SNAPSHOT

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

DB_MAIN_HOST=localhost
DB_MAIN_PORT=5432
DB_MAIN_NAME=marketplace_main
DB_MAIN_USERNAME=marketplace_user
DB_MAIN_PASSWORD=marketplace_pass

DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT=30000

# =============================================================================
# MESSAGE BROKER (RabbitMQ — usado pelo Outbox Relay)
# =============================================================================

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# =============================================================================
# SECURITY
# =============================================================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-256-bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=queroja

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-characters
ENCRYPTION_ALGORITHM=AES/GCM/NoPadding

# =============================================================================
# OBSERVABILITY
# =============================================================================

METRICS_ENABLED=true
METRICS_EXPORT_PROMETHEUS=true

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_MARKETPLACE=DEBUG
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_HIBERNATE=WARN

# =============================================================================
# API RATE LIMITING
# =============================================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_CAPACITY=200

# =============================================================================
# PSP / ESCROW (Fase 1 — pagamento garantido via PSP autorizado BACEN)
# =============================================================================
# Preencher apenas quando o adaptador real de PSP (porta EscrowGateway do
# contexto agreement) for implementado.
# A plataforma comanda gatilhos de liberação; o dinheiro fica custodiado no PSP.

PSP_PROVIDER=
PSP_API_KEY=
PSP_WEBHOOK_SECRET=

# Adaptador mock do escrow (Fase 0/dev). Desligar quando o adaptador real
# de PSP autorizado existir — pré-condição do gate da Fase 1.
ESCROW_MOCK=true

# Janela para a transportadora entregar após o envio (dias). SHIPPED nunca é
# beco sem saída: vencida a janela sem confirmação de entrega, o sweep
# reembolsa o comprador (SELLER_DEFAULTED).
ESCROW_DELIVERY_WINDOW_DAYS=15
# Teto de ticket do escrow no kickoff (centavos). Acima disso a plataforma
# se declara indisponível em vez de carregar risco não precificado.
ESCROW_MAX_TICKET_CENTS=300000
# Janela para o comprador financiar o escrow após o aceite (horas).
ESCROW_FUNDING_WINDOW_HOURS=48
# Prazo de envio do vendedor após o funding (dias) antes de seller default.
ESCROW_SHIPPING_WINDOW_DAYS=7
# Janela de inspeção pós-entrega (horas) antes da liberação automática.
ESCROW_INSPECTION_WINDOW_HOURS=72

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

DEBUG_ENABLED=true
DEBUG_SQL_LOGGING=false

SPRING_DEVTOOLS_RESTART_ENABLED=true
SPRING_DEVTOOLS_LIVERELOAD_ENABLED=true

# Test Data
LOAD_TEST_DATA=true
TEST_DATA_USERS=100
TEST_DATA_SUPPLIERS=50
TEST_DATA_SOURCING_EVENTS=20
